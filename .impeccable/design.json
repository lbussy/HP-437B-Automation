  "narrative": {
    "northStar": "The existing report style",
    "overview": "The local operator surface inherits the owner-confirmed report style: white surfaces, dark ink, restrained blue actions, system typography, and clear rules. This document records the implemented browser surface; the report templates retain their own styles.\n\nThe interface uses spacing and dividers to separate setup, workflow progress, cancellation, and reports. Text labels accompany state colors, and operational status remains distinct from acceptance results.",
    "keyCharacteristics": [
      "White surfaces and ruled sections.",
      "Blue actions with explicit labels.",
      "Visible workflow states and cancellation boundaries.",
      "A stacked workspace on small screens."
    ],
    "rules": [
      {
        "name": "The State Text Rule",
        "body": "Preserve the text labels accompanying state colors; phase completion is separate from an acceptance decision.",
        "section": "colors"
      },
      {
        "name": "The Available Action Rule",
        "body": "Keep controls disabled or hidden according to their actual availability: setup is locked during an active suite, Start requires a selection, and reports appear only when ready.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain visible labels, state text, and completion counts alongside color.",
      "Do preserve visible keyboard focus and readable disabled states.",
      "Do wrap long descriptive text and allow the recent-runs table to scroll horizontally.",
      "Do distinguish a cancellation request from completed cancellation, and report errors from run outcomes."
    ],
    "donts": [
      "Don't infer an acceptance decision from the green Finished state.",
      "Don't hide the current workflow cleanup boundary when cancellation is requested.",
      "Don't apply this browser token sheet to report templates without checking their existing styles."
    ]
  }
